{
  "manifest_version": 3,
  "name": "CyberShield URL Inspector",
  "version": "1.0",
  "description": "Real-time AI Phishing Detector",
  "permissions": ["tabs", "activeTab", "scripting", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}